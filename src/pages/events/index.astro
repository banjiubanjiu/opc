---
import Base from '../../layouts/Base.astro';
import SectionLabel from '../../components/SectionLabel.astro';
import QuoteBlock from '../../components/QuoteBlock.astro';
import EventCard from '../../components/EventCard.astro';
import VoiceCard from '../../components/VoiceCard.astro';
import { activities } from '../../data/site';

const voices = [
  {
    quote: '他们就像我的孩子,每个细节都是一个人在四下无人的深夜或午后打磨的。',
    name: '程序员自由创业周记',
    source: '#40:结束了 · w2solo',
  },
  {
    quote: '工作并没有比北京轻松,反而工作时间变得更长,只是做自己喜欢的事情,从心态上会更积极。',
    name: '河北 · 开源作者',
    source: '月收入赶超北京工资 · w2solo',
  },
  {
    quote: '从我辞职到现在,我只做了 Reqable 这一个项目。',
    name: 'Reqable 作者',
    source: '独立开发 2 年半 · 前商汤',
  },
  {
    quote: '存的钱要够至少一年的房租、房贷和生活基本消费,这才好辞职出来折腾。',
    name: '李唐',
    source: '钱迹 App 作者 · w2solo',
  },
  {
    quote: '独立开发者的体验:爽、纯粹、发现更多可能、健康是最重要的。',
    name: '李唐',
    source: '钱迹 App 作者 · w2solo',
  },
  {
    quote: '把“一人公司”从创业神话,还原为一种可迁移的思维模型。',
    name: '图灵的猫',
    source: 'B 站 · 概念祛魅',
  },
  {
    quote: '做了一场 13 个月的梦。',
    name: '程序员自由创业周记',
    source: '#39 · w2solo',
  },
];
---

<Base title="活动" description="OPC 社区线下沙龙:AI × 科技向善 × 永续发展">
  <!-- 为什么办活动 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <SectionLabel no="01" label="为什么办活动" />
      <h1 class="display-xl mt-8">不只在线交流,更要真实相遇。</h1>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
        不是一次性的课程或活动,而是长期陪伴的现场。我们把科技向善、真实与永续,
        设计进每一场活动——它不是一个下午的聚会,而是一次次把理念落地的练习。
      </p>
      <div class="mt-8">
        <QuoteBlock
          quote="技术赋能公益,创新蕴含温情。"
          source="CCF 技术公益黑客马拉松 · 主题"
        />
      </div>
    </div>
  </section>

  <!-- 我们有什么不一样 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <SectionLabel no="02" label="我们的活动,有什么不一样" />
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {[
          ['小', '每场十几人,每个人都有开口的机会,而不是坐在台下听。'],
          ['真', '分享只讲真做过的——「言而当,知也;默而当,亦知也。」'],
          ['善', '主旋律是 AI 与科技向善:聊的不只是怎么赚钱,还有科技怎么缓解真实的苦楚。'],
        ].map(([t, d]) => (
          <div class="rounded-xl bg-surface-card p-5">
            <p class="font-serif text-lg font-medium text-ink">{t}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{d}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-muted">
        「永续」落在细节:小规模、低成本、公益透明——让活动可以一直办下去。
        <span class="mt-1 block font-serif italic">Less isolating, more sustainable.</span>
      </p>
    </div>
  </section>

  <!-- 你能得到什么 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <SectionLabel no="03" label="来一场,你能得到什么" />
      <h2 class="display-lg mt-8">无论你走到哪一步,都有对应的一场。</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {[
          ['想法期', '把想法说出来,24 小时内收到同行者的真实反馈。', 'Coffee Chat'],
          ['验证期', '听踩过坑的人讲获客、验证、定价——别闷头准备三个月。', '闭门沙龙'],
          ['MVP 期', 'AI 工具实战,把开发周期从月压到周。', '主题工作坊'],
        ].map(([t, d, tag]) => (
          <div class="rounded-xl bg-surface-card p-5">
            <p class="text-xs text-muted">{tag}</p>
            <p class="mt-1 font-serif text-lg font-medium">{t}</p>
            <p class="mt-2 text-sm leading-relaxed text-muted">{d}</p>
          </div>
        ))}
      </div>
      <p class="mt-6 text-xs text-muted">
        每场活动都标注适合的阶段,按需参加,不必从头开始。
      </p>
    </div>
  </section>

  <!-- 同行者的声音 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <SectionLabel no="04" label="同行者的声音" />
      <h2 class="display-lg mt-8">先听听,再出发。</h2>
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
        下面这些话,来自已经在路上的人——独立开发者、开源作者、App 作者。
        有甜头,也有苦水;出发之前,先听听真的。
      </p>
      <!-- 首条声音:大引言 -->
      <figure class="mt-10 border-t border-line pt-8">
        <blockquote class="display-lg max-w-3xl text-ink">
          “{voices[0].quote}”
        </blockquote>
        <figcaption class="mt-4 flex items-baseline gap-3 text-sm">
          <span class="font-medium">{voices[0].name}</span>
          <span class="text-xs text-muted">{voices[0].source}</span>
        </figcaption>
      </figure>
      <!-- 其余声音:双栏规则行 -->
      <div class="mt-10 grid gap-x-12 gap-y-7 lg:grid-cols-2">
        {voices.slice(1).map((v) => <VoiceCard {...v} />)}
      </div>
    </div>
  </section>

  <!-- 近期活动 -->
  <section class="border-b border-line">
    <div class="mx-auto max-w-5xl px-5 py-16 sm:py-20">
      <SectionLabel no="05" label="近期活动" />
      <p class="mt-6 max-w-2xl text-sm leading-relaxed text-muted">
        目前我们主要活跃在<span class="text-ink">佛山、广州</span>,
        深圳等更多广东城市也在陆续开启。
      </p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        {activities.map((a) => <EventCard activity={a} />)}
      </div>
      <p class="mt-8 text-xs text-muted">
        活动为公益,仅需支付 49 元茶水费。
      </p>
    </div>
  </section>
</Base>
