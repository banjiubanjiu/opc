---
import { site } from '../data/site';

const nav = [
  { href: '/', label: '首页' },
  { href: '/about/', label: '理念' },
  { href: '/events/', label: '活动' },
  { href: '/signup/', label: '报名' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-paper/90 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4">
    <a href="/" class="flex items-baseline gap-2">
      <span class="font-serif text-lg font-semibold tracking-wide">{site.shortName}</span>
      <span class="hidden text-xs text-muted sm:inline">一人公司社区</span>
    </a>
    <nav class="flex items-center gap-6 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'text-muted transition-colors hover:text-ink',
              Astro.url.pathname === item.href && 'text-ink underline decoration-coral decoration-2 underline-offset-4',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/signup/"
        class="hidden rounded-full bg-ink px-4 py-2 text-sm text-paper transition-opacity hover:opacity-85 sm:inline-block"
      >
        加入社区
      </a>
    </nav>
  </div>
</header>
