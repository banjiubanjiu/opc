---
import type { Activity } from '../data/site';

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
const { date } = activity;
const dateText = `${date.slice(5, 7)}月${date.slice(8, 10)}日`;
---

<a
  href={`/events/${activity.slug}/`}
  class="group block rounded-lg bg-surface-card p-6 transition-opacity hover:opacity-90"
>
  <div class="flex items-center justify-between">
    <span class="font-mono text-sm text-ink">{dateText}</span>
    <span class="text-xs text-muted">{activity.city}</span>
  </div>
  <h3 class="mt-3 font-serif text-lg font-medium leading-snug">
    {activity.title}
  </h3>
  <p class="mt-2 line-clamp-2 text-sm text-muted">{activity.intro}</p>
  <p class="mt-4 flex items-center gap-3 text-xs">
    <span class="rounded-full border border-coral/50 px-2.5 py-0.5 text-coral">
      {activity.stage}
    </span>
    <span class="font-mono text-muted">{activity.time}</span>
  </p>
</a>
