---
import type { Activity } from '../data/site';

interface Props {
  activity: Activity;
}

const { activity } = Astro.props;
const { date } = activity;
const dateText = `${date.slice(5, 7)}月${date.slice(8, 10)}日`;
---

<a
  href={`/events/${activity.slug}/`}
  class="group block rounded-lg border border-line bg-white/50 p-6 transition-all hover:border-accent hover:shadow-sm"
>
  <div class="flex items-center justify-between">
    <span class="font-serif text-sm text-accent">{dateText}</span>
    <span class="text-xs text-muted">{activity.city}</span>
  </div>
  <h3 class="mt-3 font-serif text-lg font-semibold leading-snug group-hover:text-accent">
    {activity.title}
  </h3>
  <p class="mt-2 line-clamp-2 text-sm text-muted">{activity.intro}</p>
  <p class="mt-4 flex items-center gap-2 text-xs">
    <span class="rounded-full border border-line px-2 py-0.5 text-accent">{activity.stage}</span>
    <span class="text-muted">{activity.time}</span>
  </p>
</a>
