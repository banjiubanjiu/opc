---
interface Props {
  no: string;
  label: string;
}

const { no, label } = Astro.props;
---

<div class="flex items-center gap-3">
  <span class="font-mono text-xs text-coral">/{no}</span>
  <span class="text-xs font-medium uppercase tracking-[0.18em] text-muted">{label}</span>
  <span class="h-px flex-1 bg-line"></span>
</div>
