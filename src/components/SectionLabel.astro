---
interface Props {
  no: string;
  label: string;
}

const { no, label } = Astro.props;
---

<div class="flex items-center gap-3">
  <span class="font-serif text-sm text-accent">{no}</span>
  <span class="text-xs uppercase tracking-[0.2em] text-muted">{label}</span>
  <span class="h-px flex-1 bg-line"></span>
</div>
