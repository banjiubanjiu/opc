---
import { site } from '../data/site';
---

<footer class="bg-ink text-on-dark">
  <div class="mx-auto max-w-5xl px-5 py-16">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-serif text-lg font-semibold">{site.name}</p>
        <p class="mt-2 max-w-sm text-sm text-on-dark-soft">
          一个人可以是一家公司,但不必一个人走完全程。
        </p>
      </div>
      <div class="text-sm text-on-dark-soft">
        <p class="mono-eyebrow text-coral">Contact</p>
        <p class="mt-2">微信:{site.contact.wechat}</p>
        <p>邮箱:{site.contact.email}</p>
      </div>
    </div>
    <p class="mt-10 border-t border-on-dark/10 pt-6 text-xs text-on-dark-soft/70">
      © {new Date().getFullYear()} {site.name} · 做对自己和用户都诚实的产品
    </p>
  </div>
</footer>
