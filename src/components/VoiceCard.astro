---
interface Props {
  quote: string;
  name: string;
  source: string;
}

const { quote, name, source } = Astro.props;
---

<figure class="border-t border-line pt-6">
  <blockquote class="font-serif text-lg leading-relaxed text-ink sm:text-xl">
    “{quote}”
  </blockquote>
  <figcaption class="mt-3 flex flex-wrap items-baseline gap-x-3 gap-y-1 text-sm">
    <span class="font-medium">{name}</span>
    <span class="text-xs text-muted">{source}</span>
  </figcaption>
</figure>
