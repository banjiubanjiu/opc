---
interface Props {
  quote: string;
  name: string;
  source: string;
}

const { quote, name, source } = Astro.props;
---

<figure class="flex h-full flex-col justify-between rounded-lg border border-line bg-white/50 p-6">
  <blockquote class="text-sm leading-relaxed text-ink/90">
    “{quote}”
  </blockquote>
  <figcaption class="mt-5 border-t border-line pt-3">
    <p class="text-sm font-medium">{name}</p>
    <p class="text-xs text-muted">{source}</p>
  </figcaption>
</figure>
