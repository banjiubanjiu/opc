---
interface Props {
  quote: string;
  source?: string;
}

const { quote, source } = Astro.props;
---

<figure class="border-l-2 border-coral pl-5">
  <blockquote class="font-serif text-xl leading-relaxed text-ink sm:text-2xl">
    「{quote}」
  </blockquote>
  {source && <figcaption class="mt-3 text-sm text-muted">—— {source}</figcaption>}
</figure>
